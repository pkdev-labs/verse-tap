{
  "name": "pkdev/verse-tap",
  "description": "PHP client for Bible verses and passages from the ESV API and API.Bible, as text or HTML",
  "type": "library",
  "license": "MIT",
  "keywords": ["bible", "verse", "esv", "api.bible", "scripture"],
  "authors": [
    {
      "name": "Phil Konsor"
    }
  ],
  "autoload": {
    "psr-4": {
      "PkDev\\VerseClient\\": "src/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.2",
    "laravel/pint": "^1.32"
  },
  "autoload-dev": {
    "psr-4": {
      "PkDev\\VerseClient\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit tests",
    "test-coverage": "vendor/bin/phpunit tests --coverage-html coverage",
    "analyze": "vendor/bin/phpstan analyse"
  },
  "minimum-stability": "stable",
  "support": {
    "issues": "https://github.com/pkdev-labs/verse-tap/issues",
    "source": "https://github.com/pkdev-labs/verse-tap"
  }
}
